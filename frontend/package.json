{
  "name": "debatemeet-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "depcruise": "depcruise src",
    "budget": "node scripts/check-budget.ts",
    "contract": "openapi-typescript src/contract/openapi.json --output src/contract/api.d.ts"
  },
  "dependencies": {
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/fira-sans-extra-condensed": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-client": "^2.22.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.4.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
