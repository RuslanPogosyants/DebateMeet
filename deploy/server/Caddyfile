# Caddy on the stand and in prod (docs/architecture.md §6 and §10), in the host network.
# Domains come from .env (env.example). Certificates are issued over ACME HTTP-01 on port 80.
{
	email {$DM_ACME_EMAIL}
	servers :443 {
		# TURN/TLS shares 443 with HTTPS. A connection for the TURN domain goes to LiveKit's TURN
		# before any HTTP server sees it; every other connection falls through to the sites below,
		# so they still see the real client address.
		listener_wrappers {
			layer4 {
				@turn tls sni {$DM_TURN_DOMAIN}
				route @turn {
					tls
					proxy 127.0.0.1:5349
				}
			}
			tls
		}
		# No HTTP/3: UDP 443 is closed.
		protocols h1 h2
	}
}

(headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		# The round link is the key to the round: it must not leak to other sites.
		Referrer-Policy no-referrer
		-Server
	}
}

{$DM_APP_DOMAIN} {
	import headers
	encode zstd gzip

	# The API. /internal/ is never proxied: LiveKit sends webhooks to the backend directly.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			# While the backend restarts: retries only connections that were never made.
			lb_try_duration 10s
		}
	}

	# Hashed files of recent releases: a tab of an older release still loads its chunks.
	handle /assets/* {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The current release: every other path is the SPA.
	handle {
		root * /srv/web/current
		try_files {path} /index.html
		header Cache-Control no-cache
		file_server
	}
}

{$DM_LIVEKIT_DOMAIN} {
	import headers
	reverse_proxy 127.0.0.1:7880
}

# Here only for its certificate: TLS connections for this domain never reach HTTP.
{$DM_TURN_DOMAIN} {
	abort
}
