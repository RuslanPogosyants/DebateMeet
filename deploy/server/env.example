# Per-server values for compose.yaml: on the server this becomes .env next to it.
# Secrets live only there and in the password manager (docs/architecture.md §10).

# stage or prod.
DM_ENVIRONMENT=stage

# Registry prefix; third-party images are mirrored under <registry>/mirror/.
DM_REGISTRY=cr.selcloud.ru/debatemeet
# The static folder the deploy agent fills; Caddy mounts it read-only.
DM_WEB_ROOT=/srv/debatemeet/web
# DM_BACKEND_IMAGE is not here: the deploy agent sets it to <registry>/backend@sha256:<digest>.

DM_APP_DOMAIN=stage.example.ru
DM_LIVEKIT_DOMAIN=livekit.stage.example.ru
DM_TURN_DOMAIN=turn.stage.example.ru
# The address the ACME CA writes to about the certificates.
DM_ACME_EMAIL=admin@example.ru
# The public IPv4 of the server: LiveKit gives it to clients as the media address.
DM_NODE_IP=203.0.113.10

# Hex only, as it goes into the database URL: openssl rand -hex 32
DM_POSTGRES_PASSWORD=
# The backend signs tokens with this key and LiveKit signs webhooks with it. A new pair:
# docker run --rm livekit/livekit-server:v1.13.7 generate-keys
DM_LIVEKIT_API_KEY=
DM_LIVEKIT_API_SECRET=
# During a key rotation the previous key keeps working: "oldkey: oldsecret".
DM_LIVEKIT_RETIRING_KEYS=
